# Copy to .env for local development (never commit .env)

SECRET_KEY=change-me-use-a-long-random-string
DEBUG=1
DATABASE_URL=sqlite:///db.sqlite3

# Channels / Redis (docker-compose sets redis://redis:6379/0 for the web container)
REDIS_URL=redis://127.0.0.1:6379/0

# Auction mashup (BaT-lite)
AUCTION_MIN_INCREMENT_IDR=50000
AUCTION_SOFT_CLOSE_MINUTES=2
AUCTION_SOFT_CLOSE_EXTEND_MINUTES=2
AUCTION_MIN_CHECKLIST=3

# Optional S3-compatible media (set USE_S3=1 to enable)
USE_S3=0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=

# NegoMotor buyer platform fee (anti-bypass unlock). Simulated checkout by default.
PLATFORM_FEE_RATE=0.03
PLATFORM_FEE_MIN_IDR=150000
PLATFORM_FEE_MAX_IDR=2500000
PLATFORM_FEE_SIMULATED=1

# Financing / simulasi kredit (estimasi only — not lender approval)
FINANCING_DEFAULT_FLAT_RATE=0.14
FINANCING_DEFAULT_EFFECTIVE_RATE=0.24
FINANCING_DEFAULT_DP_PCT=0.20
FINANCING_DEFAULT_TENOR_MONTHS=24
FINANCING_ADMIN_FEE_IDR=250000
