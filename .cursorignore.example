# Copy to .cursorignore (gitignored locally) to keep AI context focused.
# cp .cursorignore.example .cursorignore   # Git Bash
# copy .cursorignore.example .cursorignore # cmd/PowerShell

.venv/
node_modules/
frontend/node_modules/
**/__pycache__/
*.py[cod]
db.sqlite3
.env
.env.*
!.env.example

# Large or regenerable ML assets (keep MODEL_CARD.md / json specs if you want agents to read them)
data/raw/
data/staging/
artifacts/models/*.joblib
